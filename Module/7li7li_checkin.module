name: "7li7li 杂货铺自动签到模块"
description: "Safari 打开 store.7li7li.com 刷新即可静默抓取凭证，每天 08:30 自动签到领积分。"
author: "zwhyaa"
homepage: "https://store.7li7li.com"
icon: "https://store.7li7li.com/favicon"

mitm:
  hostnames:
    - "store.7li7li.com"

scriptings:
  - http-response:
      name: "7li7li_GetCookie"
      match: "^https://store\\.7li7li\\.com/api/"
      script-url: "https://raw.githubusercontent.com/zwhyaa/MyEgern/main/Module/7li7li_checkin.js"
      body-required: true

  - cron:
      name: "7li7li_AutoCheckin"
      cron: "30 8 * * *"
      script-url: "https://raw.githubusercontent.com/zwhyaa/MyEgern/main/Module/7li7li_checkin.js"
