name: "7li7li 自动签到（远程脚本）"
description: "登录后自动抓取凭证，每天 08:30 签到。使用远程 JS 文件，更新方便。"
author: "zwhyaa"
homepage: "https://store.7li7li.com"
icon: "https://store.7li7li.com/favicon.ico"

mitm:
  hostnames:
    - "store.7li7li.com"

scriptings:
  - http-response:
      name: "7li7li_GetCookie"
      match: "^https://store\\.7li7li\\.com/(auth|api/auth|api/login|api/user)/"
      script-url: "https://raw.githubusercontent.com/zwhyaa/MyEgern/main/Module/7li7li_getcookie.js"
      body-required: true

  - cron:
      name: "7li7li_AutoCheckin"
      cron: "30 8 * * *"
      script-url: "https://raw.githubusercontent.com/zwhyaa/MyEgern/main/Module/7li7li_checkin.js"
